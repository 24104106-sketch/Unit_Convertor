pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out React project from GitHub...'
            }
        }

        stage('Display Project Files') {
            steps {
                bat 'dir'
                bat 'dir Smart-Unit-Converter'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('Smart-Unit-Converter') {
                    bat 'npm install'
                }
            }
        }

        stage('Build React Application') {
            steps {
                dir('Smart-Unit-Converter') {
                    bat 'npm run build'
                }
            }
        }

        stage('Verify Build') {
            steps {
                dir('Smart-Unit-Converter') {
                    bat '''
                    if exist dist\\index.html (
                        echo React Vite build successful
                        echo dist\\index.html found
                    ) else (
                        echo Build failed - dist\\index.html missing
                        exit /b 1
                    )
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('Smart-Unit-Converter') {
                    archiveArtifacts artifacts: 'dist/**', fingerprint: true

                    echo '=========================================='
                    echo 'React application deployed as Jenkins artifact.'
                    echo '=========================================='
                }
            }
        }
    }

    post {

        success {
            echo '=========================================='
            echo 'PIPELINE SUCCESS'
            echo 'Smart Unit Converter built successfully.'
            echo 'Build artifacts are available in Jenkins.'
            echo '=========================================='
        }

        failure {
            echo '=========================================='
            echo 'PIPELINE FAILED'
            echo 'Check the console output for errors.'
            echo '=========================================='
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}