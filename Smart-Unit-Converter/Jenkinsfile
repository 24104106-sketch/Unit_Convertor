pipeline {
    agent any

    stages {

        stage('Checkout Source Code') {
            steps {
                echo 'Checking out React project from GitHub...'
                checkout scm
            }
        }

        stage('Display Project Files') {
            steps {
                bat '''
                echo ===== ROOT FILES =====
                dir

                echo ===== REACT PROJECT FILES =====
                dir Smart-Unit-Converter
                '''
            }
        }

        stage('Verify React Project') {
            steps {
                bat '''
                if exist "Smart-Unit-Converter\\package.json" (
                    echo package.json Found
                ) else (
                    echo package.json Missing
                    exit /b 1
                )

                if exist "Smart-Unit-Converter\\src" (
                    echo src folder Found
                ) else (
                    echo src folder Missing
                    exit /b 1
                )
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                bat '''
                cd Smart-Unit-Converter
                call npm ci
                '''
            }
        }

        stage('Build React Application') {
            steps {
                bat '''
                cd Smart-Unit-Converter
                call npm run build
                '''
            }
        }

        stage('Verify Build') {
            steps {
                bat '''
                if exist "Smart-Unit-Converter\\dist\\index.html" (
                    echo React build successful
                    echo dist/index.html Found
                ) else (
                    echo React build failed
                    exit /b 1
                )
                '''
            }
        }
    }

    post {
        success {
            echo '======================================'
            echo 'React Smart Unit Converter SUCCESS'
            echo '======================================'
        }

        failure {
            echo 'React build failed. Check Console Output.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}