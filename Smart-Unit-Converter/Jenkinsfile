pipeline {
    agent any

    stages {

        stage('Checkout Source Code') {
            steps {
                echo 'Checking out source code from GitHub...'
                checkout scm
            }
        }

        stage('Display Project Files') {
            steps {
                bat 'dir'
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing React dependencies...'
                bat 'call npm install'
            }
        }

        stage('Build React Project') {
            steps {
                echo 'Building React project...'
                bat 'call npm run build'
            }
        }

        stage('Deploy') {
            steps {
                bat '''
                if not exist "C:\\ProgramData\\Jenkins.jenkins\\userContent\\smart-unit-converter" mkdir "C:\\ProgramData\\Jenkins.jenkins\\userContent\\smart-unit-converter"

                xcopy /E /I /Y "dist\\*" "C:\\ProgramData\\Jenkins.jenkins\\userContent\\smart-unit-converter\\"
                '''
            }
        }

        stage('Build Successful') {
            steps {
                echo '======================================='
                echo 'Smart Unit Converter Build Successful'
                echo '======================================='
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Please check the errors.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}