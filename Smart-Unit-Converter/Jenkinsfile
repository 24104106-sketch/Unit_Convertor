pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out React project...'
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing dependencies...'
                bat 'npm install'
            }
        }

        stage('Build React Project') {
            steps {
                echo 'Building React + Vite project...'
                bat 'npm run build'
            }
        }

        stage('Verify Build') {
            steps {
                bat '''
                if exist dist\\index.html (
                    echo React production build found.
                ) else (
                    echo React production build missing.
                    exit /b 1
                )
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying React build...'

                bat '''
                if not exist "C:\\ProgramData\\Jenkins.jenkins\\userContent\\smart-unit-converter" mkdir "C:\\ProgramData\\Jenkins.jenkins\\userContent\\smart-unit-converter"

                xcopy /E /I /Y "dist\\*" "C:\\ProgramData\\Jenkins.jenkins\\userContent\\smart-unit-converter\\"
                '''
            }
        }
    }

    post {
        success {
            echo '======================================'
            echo 'SMART UNIT CONVERTER PIPELINE SUCCESS'
            echo '======================================'
        }

        failure {
            echo 'Pipeline failed. Check the console output.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}