pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out React project from GitHub...'
            }
        }

        stage('Display Project Files') {
            steps {
                bat 'dir'
                bat 'dir Smart-Unit-Converter'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('Smart-Unit-Converter') {
                    bat 'npm install'
                }
            }
        }

        stage('Build React Application') {
            steps {
                dir('Smart-Unit-Converter') {
                    bat 'npm run build'
                }
            }
        }

        stage('Verify Build') {
            steps {
                dir('Smart-Unit-Converter') {
                    bat '''
                    if exist dist\\index.html (
                        echo React Vite build successful
                        echo dist\\index.html found
                    ) else (
                        echo Build failed - dist\\index.html missing
                        exit /b 1
                    )
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('Smart-Unit-Converter') {
                    bat '''
                    if not exist "C:\\ProgramData\\Jenkins.jenkins\\userContent\\smart-unit-converter" (
                        mkdir "C:\\ProgramData\\Jenkins.jenkins\\userContent\\smart-unit-converter"
                    )

                    xcopy /E /I /Y "dist\\*" "C:\\ProgramData\\Jenkins.jenkins\\userContent\\smart-unit-converter\\"

                    echo ==========================================
                    echo React application deployed successfully.
                    echo ==========================================
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                bat '''
                if exist "C:\\ProgramData\\Jenkins.jenkins\\userContent\\smart-unit-converter\\index.html" (
                    echo Deployment verified successfully.
                    echo index.html found in Jenkins userContent.
                ) else (
                    echo Deployment verification failed.
                    exit /b 1
                )
                '''
            }
        }
    }

    post {

        success {
            echo '=========================================='
            echo 'PIPELINE SUCCESS'
            echo 'Smart Unit Converter deployed successfully.'
            echo '=========================================='
            echo 'Open: http://localhost:8080/userContent/smart-unit-converter/'
        }

        failure {
            echo '=========================================='
            echo 'PIPELINE FAILED'
            echo 'Check the console output for errors.'
            echo '=========================================='
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}